            const [classes, setClasses] = useState(initialClasses);
            const [jamBelajar, setJamBelajar] = useState(initialJamBelajar);
            const [admins, setAdmins] = useState(initialAdmins);
            const [attendanceList, setAttendanceList] = useState([]);

            const showToast = (msg) => setToast(msg);

            const addAttendance = (record) => {
                setAttendanceList([record, ...attendanceList]);
            };

            const menus = [
                { id: 'dashboard', label: 'Dashboard', icon: 'fas fa-home' },
                { id: 'input_absen', label: 'Input Absen', icon: 'fas fa-fingerprint' },
                { label: 'MASTER DATA', isHeader: true },
                { id: 'data_siswa', label: 'Data Siswa', icon: 'fas fa-user-graduate' },
                { id: 'data_kelas', label: 'Data Kelas', icon: 'fas fa-school' },
                { id: 'jam_belajar', label: 'Jam Belajar', icon: 'fas fa-clock' },
                { label: 'LAPORAN', isHeader: true },
                { id: 'laporan_absensi', label: 'Laporan Absensi', icon: 'fas fa-file-alt' },
                { id: 'laporan_harian', label: 'Laporan Harian', icon: 'fas fa-calendar-day' },
                { label: 'PENGATURAN', isHeader: true },
                { id: 'admin', label: 'Admin', icon: 'fas fa-user-shield' }
            ];

            const renderContent = () => {
                switch (currentMenu) {
                    case 'dashboard': return <Dashboard setMenu={setCurrentMenu} />;
                    case 'input_absen': return <InputAbsen students={students} attendanceList={attendanceList} showToast={showToast} addAttendance={addAttendance} />;
                    case 'data_siswa': return <DataSiswa students={students} setStudents={setStudents} classes={classes} showToast={showToast} />;
                    case 'data_kelas': return <DataKelas classes={classes} setClasses={setClasses} showToast={showToast} />;
                    case 'jam_belajar': return <DataJamBelajar jamBelajar={jamBelajar} showToast={showToast} />;
                    case 'laporan_absensi': return <LaporanAbsensi students={students} attendanceList={attendanceList} jamBelajar={jamBelajar} />;
                    case 'laporan_harian': return <LaporanHarian students={students} attendanceList={attendanceList} jamBelajar={jamBelajar} />;
                    case 'admin': return <AdminView admins={admins} showToast={showToast} />;
                    default: return <Dashboard setMenu={setCurrentMenu} />;
                }
            };

            return (
                <div className="flex h-screen overflow-hidden bg-gray-100 font-sans">
                    {/* Sidebar */}
                    <aside className="w-64 bg-gray-900 text-white flex flex-col shadow-2xl z-10">
                        <div className="p-4 bg-gray-950 flex items-center justify-center border-b border-gray-800">
                            <div className="text-center">
                                <div className="w-12 h-12 bg-primary rounded-full mx-auto mb-2 flex items-center justify-center">
                                    <i className="fas fa-mosque text-xl"></i>
                                </div>
                                <h1 className="font-bold text-lg leading-tight tracking-wide">MIM Unggulan</h1>
                                <p className="text-xs text-gray-400">Kota Gorontalo</p>
                            </div>
                        </div>
                        <div className="flex-1 overflow-y-auto py-4">
                            <nav className="space-y-1">
                                {menus.map((m, idx) => {
                                    if (m.isHeader) {
                                        return <div key={idx} className="px-6 mt-6 mb-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">{m.label}</div>;
                                    }
                                    const active = currentMenu === m.id;
                                    return (
                                        <button
                                            key={idx}
                                            onClick={() => setCurrentMenu(m.id)}
                                            className={`w-full flex items-center px-6 py-3 text-sm font-medium transition-colors ${active ? 'bg-primary text-white border-l-4 border-white' : 'text-gray-300 hover:bg-gray-800 hover:text-white border-l-4 border-transparent'}`}
                                        >
                                            <i className={`${m.icon} w-6 text-center mr-3 text-lg ${active ? 'text-white' : 'text-gray-400'}`}></i>
                                            {m.label}
                                        </button>
                                    )
                                })}
                            </nav>
                        </div>
                    </aside>

                    {/* Main Content */}
                    <div className="flex-1 flex flex-col overflow-hidden relative">
                        {/* Header */}
                        <header className="bg-white shadow-sm h-16 flex items-center justify-between px-6 z-10">
                            <div className="flex items-center text-xl font-semibold text-gray-800 capitalize">
                                {currentMenu.replace('_', ' ')}
                            </div>
                            <div className="flex items-center gap-4">
                                <button className="text-gray-400 hover:text-gray-600"><i className="fas fa-bell"></i></button>
                                <div className="h-8 w-8 rounded-full bg-primary flex items-center justify-center text-white font-bold">
                                    A
                                </div>
                            </div>
                        </header>

                        {/* Page Content */}
                        <main className="flex-1 overflow-x-hidden overflow-y-auto bg-gray-100 p-6">
                            {renderContent()}
                        </main>
                    </div>

                    {/* Toast Notification Overlay */}
                    {toast && <Toast message={toast} onClose={() => setToast(null)} />}
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
