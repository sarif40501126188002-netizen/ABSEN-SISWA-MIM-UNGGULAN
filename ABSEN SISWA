<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Informasi Absensi - MIM Unggulan Kota Gorontalo</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- React & ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Babel -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- SheetJS for XLSX export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: { primary: '#059669', secondary: '#10b981' } // Emerald green theme
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useMemo } = React;

        // --- MOCK DATA ---
        const initialStudents = [
            { id: 1, nama: 'Ahmad Fauzi', kelas: '1A' },
            { id: 2, nama: 'Budi Santoso', kelas: '1A' },
            { id: 3, nama: 'Siti Aminah', kelas: '2B' },
            { id: 4, nama: 'Zahra Larasati', kelas: '3C' },
        ];
        const initialClasses = [
            { id: 1, nama: '1A', jumlah: 32 },
            { id: 2, nama: '2B', jumlah: 30 },
            { id: 3, nama: '3C', jumlah: 28 },
        ];
        const initialJamBelajar = [
            { id: 1, hari: 'Senin', masuk: '07:00', pulang: '14:00', izin: '1', status: 'Masuk Belajar' },
            { id: 2, hari: 'Selasa', masuk: '07:00', pulang: '14:00', izin: '1', status: 'Masuk Belajar' },
            { id: 3, hari: 'Rabu', masuk: '07:00', pulang: '14:00', izin: '1', status: 'Masuk Belajar' },
            { id: 4, hari: 'Kamis', masuk: '07:00', pulang: '14:00', izin: '1', status: 'Masuk Belajar' },
            { id: 5, hari: 'Jumat', masuk: '07:00', pulang: '11:30', izin: '1', status: 'Masuk Belajar' },
            { id: 6, hari: 'Sabtu', masuk: '-', pulang: '-', izin: '0', status: 'Libur' },
            { id: 7, hari: 'Minggu', masuk: '-', pulang: '-', izin: '0', status: 'Libur' },
        ];
        const initialAdmins = [
            { id: 1, nama: 'Admin Utama', username: 'admin1', email: 'admin@mim.sch.id', jabatan: 'Kepala Tata Usaha' }
        ];

        // --- UTILITY FUNCTIONS ---
        const exportToXLSX = (tableId, filename) => {
            const table = document.getElementById(tableId);
            if (!table) return;
            // Menggunakan library XLSX (SheetJS) untuk mengeksport tabel HTML ke file .xlsx
            const wb = XLSX.utils.table_to_book(table, { sheet: "Laporan Harian" });
            XLSX.writeFile(wb, filename + ".xlsx");
        };

        const exportToExcel = (tableId, filename) => {
            const table = document.getElementById(tableId);
            if (!table) return;
            let csv = [];
            for (let i = 0; i < table.rows.length; i++) {
                let row = [], cols = table.rows[i].querySelectorAll("td, th");
                for (let j = 0; j < cols.length; j++) 
                    row.push('"' + cols[j].innerText.replace(/"/g, '""') + '"');
                csv.push(row.join(","));
            }
            const csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
            const downloadLink = document.createElement("a");
            downloadLink.download = filename + ".csv";
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        };

        const exportToMarkdown = (tableId, filename) => {
            const table = document.getElementById(tableId);
            if (!table) return;
            
            let rows = [];
            let colWidths = [];
            
            // Ekstrak data dan hitung lebar kolom maksimum untuk kerapian
            for (let i = 0; i < table.rows.length; i++) {
                let row = [];
                let cols = table.rows[i].querySelectorAll("td, th");
                for (let j = 0; j < cols.length; j++) {
                    const text = cols[j].innerText.trim();
                    row.push(text);
                    if (!colWidths[j] || text.length > colWidths[j]) {
                        colWidths[j] = Math.max(text.length, 3); // Minimal lebar 3
                    }
                }
                rows.push(row);
            }
            
            // Bangun string Markdown dengan padding spasi agar sejajar
            let md = "";
            rows.forEach((row, rowIndex) => {
                let paddedRow = row.map((cell, colIndex) => cell.padEnd(colWidths[colIndex], ' '));
                md += "| " + paddedRow.join(" | ") + " |\n";
                
                // Tambahkan garis pemisah header
                if (rowIndex === 0) {
                    let separator = colWidths.map(width => "-".repeat(width));
                    md += "|-" + separator.join("-|-") + "-|\n";
                }
            });

            const mdFile = new Blob([md], {type: "text/markdown"});
            const downloadLink = document.createElement("a");
            downloadLink.download = filename + ".md";
            downloadLink.href = window.URL.createObjectURL(mdFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        };

        // --- COMPONENTS ---

        // 1. TOAST NOTIFICATION
        const Toast = ({ message, onClose }) => {
            useEffect(() => {
                const timer = setTimeout(onClose, 3000);
                return () => clearTimeout(timer);
            }, [onClose]);
            return (
                <div className="fixed top-5 right-5 bg-primary text-white px-6 py-3 rounded shadow-lg z-50 flex items-center gap-4 transition-all animate-bounce">
                    <span><i className="fas fa-check-circle mr-2"></i>{message}</span>
                    <button onClick={onClose} className="text-white hover:text-gray-200"><i className="fas fa-times"></i></button>
                </div>
            );
        };

        // 2. DASHBOARD VIEW
        const Dashboard = ({ setMenu }) => {
            const cards = [
                { title: 'Data Siswa', icon: 'fa-users', color: 'bg-blue-500', menu: 'data_siswa' },
                { title: 'Data Kelas', icon: 'fa-school', color: 'bg-indigo-500', menu: 'data_kelas' },
                { title: 'Data Jam Belajar', icon: 'fa-clock', color: 'bg-yellow-500', menu: 'jam_belajar' },
                { title: 'Data Laporan', icon: 'fa-chart-bar', color: 'bg-primary', menu: 'laporan_absensi' },
                { title: 'Pengaturan', icon: 'fa-cogs', color: 'bg-gray-600', menu: 'admin' },
            ];

            return (
                <div>
                    <h2 className="text-2xl font-bold mb-6 text-gray-800">Dashboard Utama</h2>
                    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {cards.map((card, idx) => (
                            <div key={idx} className="bg-white rounded-lg shadow-sm overflow-hidden flex flex-col">
                                <div className="p-5 flex justify-between items-center flex-1">
                                    <div>
                                        <h3 className="text-lg font-semibold text-gray-700">{card.title}</h3>
                                        <p className="text-sm text-gray-500 mt-1">Kelola {card.title.toLowerCase()}</p>
                                    </div>
                                    <div className={`p-4 rounded-full ${card.color} text-white`}>
                                        <i className={`fas ${card.icon} text-2xl`}></i>
                                    </div>
                                </div>
                                <button 
                                    onClick={() => setMenu(card.menu)}
                                    className="bg-gray-50 py-3 px-5 text-sm text-center text-gray-600 hover:bg-gray-100 hover:text-primary transition font-medium flex justify-center items-center gap-2 border-t"
                                >
                                    More Info {card.title.replace('Data ', '')} <i className="fas fa-arrow-circle-right"></i>
                                </button>
                            </div>
                        ))}
                    </div>
                </div>
            );
        };

        // 3. INPUT ABSEN VIEW
        const InputAbsen = ({ students, attendanceList, showToast, addAttendance }) => {
            const [currentTime, setCurrentTime] = useState(new Date());
            const [selectedName, setSelectedName] = useState('');
            const [selectedClass, setSelectedClass] = useState('');

            useEffect(() => {
                const timer = setInterval(() => setCurrentTime(new Date()), 1000);
                return () => clearInterval(timer);
            }, []);

            const handleNameChange = (e) => {
                const val = e.target.value;
                setSelectedName(val);
                const student = students.find(s => s.nama.toLowerCase() === val.toLowerCase());
                if (student) setSelectedClass(student.kelas);
                else setSelectedClass('');
            };

            const todayStr = currentTime.toLocaleDateString();
            const existingRecord = attendanceList.find(a => a.nama.toLowerCase() === selectedName.toLowerCase() && a.tanggal === todayStr);

            const handleAbsen = (status) => {
                if (!selectedName || !selectedClass) {
                    showToast('Harap lengkapi nama dan kelas!');
                    return;
                }

                if (existingRecord) {
                    showToast(`Maaf, ${selectedName} sudah melakukan absensi hari ini!`);
                    return;
                }

                addAttendance({
                    nama: selectedName,
                    kelas: selectedClass,
                    status: status,
                    waktu: currentTime.toLocaleTimeString(),
                    tanggal: todayStr,
                    hari: currentTime.toLocaleDateString('id-ID', { weekday: 'long' })
                });
                setSelectedName('');
                setSelectedClass('');
                showToast(`Berhasil: ${selectedName} - ${status}`);
            };

            return (
                <div className="bg-white rounded-lg shadow-sm p-6 max-w-2xl mx-auto mt-10">
                    <div className="text-center mb-8">
                        <h2 className="text-3xl font-bold text-gray-800"><i className="fas fa-fingerprint text-primary mr-2"></i> Input Absensi</h2>
                        <div className="mt-4 inline-block bg-primary text-white px-6 py-2 rounded-full text-lg font-semibold shadow">
                            {/* Target/Action Otomatis mengikuti format waktu */}
                            {currentTime.toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })} <br/>
                            {currentTime.toLocaleTimeString()}
                        </div>
                    </div>

                    <div className="space-y-5">
                        <div>
                            <label className="block text-sm font-medium text-gray-700 mb-1">Cari Nama Siswa</label>
                            <input 
                                type="text" 
                                list="student-list"
                                value={selectedName}
                                onChange={handleNameChange}
                                className="w-full border border-gray-300 rounded-md px-4 py-3 focus:ring-primary focus:border-primary"
                                placeholder="Ketik nama untuk mencari otomatis..."
                            />
                            <datalist id="student-list">
                                {students.map(s => <option key={s.id} value={s.nama}>{s.kelas}</option>)}
                            </datalist>
                        </div>
                        <div>
                            <label className="block text-sm font-medium text-gray-700 mb-1">Kelas (Otomatis)</label>
                            <input 
                                type="text" 
                                value={selectedClass}
                                readOnly
                                className="w-full border border-gray-300 rounded-md px-4 py-3 bg-gray-50 text-gray-600"
                                placeholder="Kelas akan terisi otomatis"
                            />
                        </div>

                        {existingRecord && (
                            <div className="p-4 bg-blue-50 border border-blue-200 text-blue-800 rounded-md flex items-start gap-3 animate-pulse">
                                <i className="fas fa-info-circle text-xl mt-0.5"></i>
                                <div className="text-sm">
                                    <p className="font-semibold mb-1">Keterangan: Data Terisi</p>
                                    <p>Siswa atas nama <strong>{existingRecord.nama}</strong> sudah terinput <strong>{existingRecord.status}</strong> pada pukul <strong>{existingRecord.waktu}</strong> sesuai jam masuk hari ini.</p>
                                </div>
                            </div>
                        )}

                        <div className="pt-4">
                            <button 
                                onClick={() => handleAbsen('Terlambat')} 
                                disabled={!!existingRecord}
                                className={`w-full py-3 rounded-lg font-medium shadow-sm transition flex items-center justify-center gap-2 ${existingRecord ? 'bg-gray-400 cursor-not-allowed text-white' : 'bg-yellow-500 hover:bg-yellow-600 text-white'}`}
                            >
                                <i className="fas fa-clock"></i> {existingRecord ? 'Sudah Terisi' : 'Terlambat'}
                            </button>
                        </div>
                    </div>
                </div>
            );
        };

        // 4. DATA SISWA (MASTER DATA)
        const DataSiswa = ({ students, setStudents, classes, showToast }) => {
            const [view, setView] = useState('table'); // table or add
            const [search, setSearch] = useState('');
            const [entries, setEntries] = useState(10);

            // State untuk dropdown import & referensi file input
            const [showImportMenu, setShowImportMenu] = useState(false);
            const excelRef = React.useRef(null);
            const wordRef = React.useRef(null);

            // State untuk fitur Edit
            const [editId, setEditId] = useState(null);
            const [editForm, setEditForm] = useState({ nama: '', kelas: '' });

            const filteredStudents = students.filter(s => s.nama.toLowerCase().includes(search.toLowerCase())).slice(0, entries);

            const handleSimpanBaru = (e) => {
                e.preventDefault();
                const newStudent = { id: Date.now(), nama: e.target.nama.value, kelas: e.target.kelas.value };
                setStudents([...students, newStudent]);
                showToast("Data Siswa berhasil ditambahkan!");
                setView('table');
            };

            const handleEditClick = (student) => {
                setEditId(student.id);
                setEditForm({ nama: student.nama, kelas: student.kelas });
            };

            const handleSaveEdit = (id) => {
                setStudents(students.map(s => s.id === id ? { ...s, nama: editForm.nama, kelas: editForm.kelas } : s));
                setEditId(null);
                showToast("Data Siswa berhasil diperbarui!");
            };

            const handleDelete = (id) => {
                setStudents(students.filter(s => s.id !== id));
                showToast("Data Siswa berhasil dihapus!");
            };

            const handleFileUpload = (e, type) => {
                if(e.target.files && e.target.files.length > 0) {
                    showToast(`Data dari file ${type} (${e.target.files[0].name}) berhasil diproses!`);
                    setShowImportMenu(false);
                    e.target.value = null; // Reset input setelah dipilih
                }
            };

            if (view === 'add') {
                return (
                    <div className="bg-white rounded-lg shadow-sm p-6">
                        <h2 className="text-xl font-bold mb-4 border-b pb-2">Tambah Siswa Baru</h2>
                        <form onSubmit={handleSimpanBaru} className="space-y-4 max-w-lg">
                            <div>
                                <label className="block text-sm font-medium text-gray-700 mb-1">Nama Siswa</label>
                                <input type="text" name="nama" required className="w-full border rounded-md px-3 py-2" placeholder="Masukkan nama..." />
                            </div>
                            <div>
                                <label className="block text-sm font-medium text-gray-700 mb-1">Kelas</label>
                                <select name="kelas" required className="w-full border rounded-md px-3 py-2">
                                    <option value="">Pilih Kelas</option>
                                    {classes.map(c => <option key={c.id} value={c.nama}>{c.nama}</option>)}
                                </select>
                            </div>
                            <div>
                                <label className="block text-sm font-medium text-gray-700 mb-1">Foto</label>
                                <input type="file" accept="image/*" className="w-full border rounded-md px-3 py-2" />
                            </div>
                            <div className="flex gap-2 pt-4">
                                <button type="submit" className="bg-primary text-white px-4 py-2 rounded shadow hover:bg-emerald-700"><i className="fas fa-save mr-1"></i> Simpan</button>
                                <button type="button" onClick={() => setView('table')} className="bg-gray-500 text-white px-4 py-2 rounded shadow hover:bg-gray-600"><i className="fas fa-times mr-1"></i> Batal</button>
                            </div>
                        </form>
                    </div>
                );
            }

            return (
                <div className="bg-white rounded-lg shadow-sm p-6">
                    <div className="flex justify-between items-center mb-6">
                        <h2 className="text-xl font-bold text-gray-800">Master Data Siswa</h2>
                        <div className="flex gap-2">
                            <button onClick={() => setView('add')} className="bg-primary text-white px-4 py-2 rounded shadow hover:bg-emerald-700">
                                <i className="fas fa-plus mr-1"></i> Tambah Baru
                            </button>
                            
                            {/* Dropdown Import Excel / Word */}
                            <div className="relative inline-block text-left">
                                <button onClick={() => setShowImportMenu(!showImportMenu)} className="bg-indigo-500 text-white px-4 py-2 rounded shadow hover:bg-indigo-600 flex items-center">
                                    <i className="fas fa-file-import mr-1"></i> Import <i className="fas fa-chevron-down ml-2 text-xs"></i>
                                </button>
                                
                                {showImportMenu && (
                                    <div className="origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-20">
                                        <div className="py-1">
                                            <button onClick={() => excelRef.current.click()} className="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 w-full text-left">
                                                <i className="fas fa-file-excel text-green-600 mr-2"></i> Import dari Excel
                                            </button>
                                            <button onClick={() => wordRef.current.click()} className="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 w-full text-left">
                                                <i className="fas fa-file-word text-blue-600 mr-2"></i> Import dari Word
                                            </button>
                                        </div>
                                    </div>
                                )}
                            </div>
                            
                            {/* Hidden File Inputs */}
                            <input type="file" ref={excelRef} accept=".xlsx, .xls, .csv" className="hidden" onChange={(e) => handleFileUpload(e, 'Excel')} />
                            <input type="file" ref={wordRef} accept=".doc, .docx" className="hidden" onChange={(e) => handleFileUpload(e, 'Word')} />
                        </div>
                    </div>
                    <div className="flex justify-between mb-4">
                        <div className="flex items-center gap-2">
                            <span className="text-sm text-gray-600">Show</span>
                            <select value={entries} onChange={(e) => setEntries(Number(e.target.value))} className="border rounded px-2 py-1 text-sm">
                                <option value={5}>5</option>
                                <option value={10}>10</option>
                                <option value={25}>25</option>
                            </select>
                            <span className="text-sm text-gray-600">Entries</span>
                        </div>
                        <input 
                            type="text" 
                            placeholder="Search Nama..." 
                            value={search}
                            onChange={(e) => setSearch(e.target.value)}
                            className="border border-gray-300 rounded-md px-3 py-1.5 focus:outline-none focus:ring-1 focus:ring-primary text-sm" 
                        />
                    </div>
                    <div className="overflow-x-auto">
                        <table className="min-w-full divide-y divide-gray-200 border">
                            <thead className="bg-gray-50">
                                <tr>
                                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">No.</th>
                                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nama</th>
                                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Kelas</th>
                                    <th className="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Aksi</th>
                                </tr>
                            </thead>
                            <tbody className="bg-white divide-y divide-gray-200">
                                {filteredStudents.map((s, i) => (
                                    <tr key={s.id}>
                                        <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{i + 1}</td>
                                        {editId === s.id ? (
                                            <>
                                                <td className="px-6 py-4 whitespace-nowrap text-sm">
                                                    <input type="text" value={editForm.nama} onChange={(e) => setEditForm({...editForm, nama: e.target.value})} className="border rounded px-2 py-1 w-full" />
                                                </td>
                                                <td className="px-6 py-4 whitespace-nowrap text-sm">
                                                    <select value={editForm.kelas} onChange={(e) => setEditForm({...editForm, kelas: e.target.value})} className="border rounded px-2 py-1 w-full">
                                                        {classes.map(c => <option key={c.id} value={c.nama}>{c.nama}</option>)}
                                                    </select>
                                                </td>
                                                <td className="px-6 py-4 whitespace-nowrap text-sm text-center">
                                                    <button onClick={() => handleSaveEdit(s.id)} className="text-green-600 hover:text-green-900 mx-2"><i className="fas fa-check"></i> Simpan</button>
                                                    <button onClick={() => setEditId(null)} className="text-gray-600 hover:text-gray-900 mx-2"><i className="fas fa-times"></i> Batal</button>
                                                </td>
                                            </>
                                        ) : (
                                            <>
                                                <td className="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{s.nama}</td>
                                                <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{s.kelas}</td>
                                                <td className="px-6 py-4 whitespace-nowrap text-sm text-center">
                                                    <button onClick={() => handleEditClick(s)} className="text-blue-600 hover:text-blue-900 mx-2"><i className="fas fa-edit"></i> Edit</button>
                                                    <button onClick={() => handleDelete(s.id)} className="text-red-600 hover:text-red-900 mx-2"><i className="fas fa-trash"></i> Hapus</button>
                                                </td>
                                            </>
                                        )}
                                    </tr>
                                ))}
                                {filteredStudents.length === 0 && (
                                    <tr><td colSpan="4" className="text-center py-4 text-gray-500">Data tidak ditemukan</td></tr>
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>
            );
        };

        // 5. DATA KELAS
        const DataKelas = ({ classes, setClasses, showToast }) => {
            const [view, setView] = useState('table');
            const [editId, setEditId] = useState(null);
            const [editForm, setEditForm] = useState({ nama: '', jumlah: '' });

            const handleSimpanBaru = (e) => {
                e.preventDefault();
                const newClass = { id: Date.now(), nama: e.target.nama.value, jumlah: e.target.jumlah.value };
                setClasses([...classes, newClass]);
                showToast("Data Kelas berhasil ditambahkan!");
                setView('table');
            };

            const handleEditClick = (c) => {
                setEditId(c.id);
                setEditForm({ nama: c.nama, jumlah: c.jumlah });
            };

            const handleSaveEdit = (id) => {
                setClasses(classes.map(c => c.id === id ? { ...c, nama: editForm.nama, jumlah: editForm.jumlah } : c));
                setEditId(null);
                showToast("Data Kelas berhasil diperbarui!");
            };

            const handleDelete = (id) => {
                setClasses(classes.filter(c => c.id !== id));
                showToast("Data Kelas berhasil dihapus!");
            };

            if (view === 'add') {
                return (
